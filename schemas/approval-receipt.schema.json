{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpermissionprotocol.com/schemas/approval-receipt.schema.json",
  "title": "APP Approval Receipt",
  "description": "Machine-readable structural schema for APP-Approval-1 signed approval receipts. Signature verification, trust validation, replay protection, and approved-scope subset checks are verifier responsibilities outside JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_receipt"
  ],
  "properties": {
    "approval_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "challenge_id",
        "policy_id",
        "approver_subject",
        "approver_authority",
        "decision",
        "approved_scope",
        "issued_at",
        "expires_at",
        "nonce",
        "signature"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "approver_subject": {
          "type": "string",
          "minLength": 1
        },
        "approver_authority": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": ["approved", "denied"]
        },
        "approved_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability"],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "resource": {
                "type": "string",
                "minLength": 1
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "limits": {
                "type": "object"
              }
            }
          }
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "nonce": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
