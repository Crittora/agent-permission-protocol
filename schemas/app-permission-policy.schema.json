{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpermissionprotocol.com/schemas/app-permission-policy.schema.json",
  "title": "APP Permission Policy",
  "description": "Machine-readable structural schema for Agent Permission Protocol v0.4.0 permission policies. Cryptographic validation, trust evaluation, subset checks, replay protection, counters, and revocation checks are verifier responsibilities outside JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "policy_version",
    "policy_id",
    "issuer",
    "subject",
    "audience",
    "intent",
    "scope",
    "issued_at",
    "not_before",
    "expires_at",
    "revocation_endpoint"
  ],
  "properties": {
    "type": {
      "const": "app_permission_policy"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^0\\.4\\.\\d+$"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scope_entry"
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revocation_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "predicates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "strict_limits": {
      "type": "boolean"
    },
    "delegation": {
      "$ref": "#/$defs/delegation"
    },
    "derivation_chain": {
      "$ref": "#/$defs/derivation_chain"
    },
    "revocation_mode": {
      "enum": ["online", "cached", "stapled"]
    },
    "approval_gate": {
      "$ref": "#/$defs/approval_gate"
    },
    "metering": {
      "type": "object"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "scope_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability"],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "constraints": {
          "type": "object"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max", "scope", "counter_ref"],
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "scope": {
              "enum": ["per_capability", "per_policy", "per_subject"]
            },
            "counter_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "token_budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "scope": {
              "enum": ["per_capability", "per_policy", "per_subject"]
            }
          }
        },
        "rate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_per_minute": {
              "type": "integer",
              "minimum": 1
            },
            "max_per_hour": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "data_volume": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_bytes_read": {
              "type": "integer",
              "minimum": 0
            },
            "max_bytes_written": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "network_zone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denied": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "time_of_day": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_windows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tz", "start", "end", "days"],
                "properties": {
                  "tz": {
                    "type": "string"
                  },
                  "start": {
                    "type": "string",
                    "pattern": "^\\d{2}:\\d{2}$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^\\d{2}:\\d{2}$"
                  },
                  "days": {
                    "type": "array",
                    "items": {
                      "enum": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "derivation_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_policy_id", "parent_policy_hash", "delegation_depth", "max_depth"],
      "properties": {
        "parent_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_policy_hash": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "delegation_depth": {
          "type": "integer",
          "minimum": 0
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approval_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "mode",
        "trigger",
        "approver",
        "approval_receipt_required",
        "timeout_seconds"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "mode": {
          "enum": ["sync", "async"]
        },
        "trigger": {
          "type": "object",
          "minProperties": 1
        },
        "approver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "enum": ["human", "service", "quorum"]
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "authority": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "approval_receipt_required": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
